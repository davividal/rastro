#!/bin/sh
# Fingerprint a remote host with rastro. The binary goes in on stdin, the
# fingerprint comes back on stdout, warnings on stderr, and nothing is left
# behind. One ssh connection, so one authentication and one login record.
#
#   rastro-ssh <rastro-binary> <ssh-destination> [ssh-option...]
#   RASTRO_SSH_SUDO=1 rastro-ssh ./rastro-aarch64 debian12
#
# The destination is passed to ssh untouched, so ~/.ssh/config decides
# everything: user, port, key, jump host, known hosts.

set -eu

if [ "$#" -lt 2 ]; then
	printf 'usage: %s <rastro-binary> <ssh-destination> [ssh-option...]\n' "${0##*/}" >&2
	exit 64
fi

binary=$1
destination=$2
shift 2

# Staged in /var/tmp because /tmp is noexec on hardened hosts and /root is in
# rastro's own walk set. The trap also fires on a dropped link, since that is a
# SIGHUP to the remote shell, so cleanup needs no second connection.
#
# `--staged` is passed because this script is the only party that knows the
# executable is a temporary copy under a name mktemp chose: rastro cannot tell it
# from an installed one, since the bytes are identical and the kernel vouches for
# both. Without the flag every run would report one added and one removed file
# that is nothing but the tool's own footprint.
#
# -o - because rastro writes to a file by default now. Without it the document
# would land in the remote working directory, which is root's home on most boxes
# and is walked, and this side would receive nothing at all.
remote_program='set -eu
staged=$(mktemp /var/tmp/rastro.XXXXXXXX)
trap "rm -f $staged" EXIT HUP INT TERM
cat >"$staged"
chmod 700 "$staged"
'"${RASTRO_SSH_SUDO:+sudo -n }"'"$staged" --staged -o -'

# -T because a pty would translate LF to CRLF and corrupt every byte of a format
# whose whole contract is byte-identical output. It comes *after* the caller's
# options on purpose: between -t and -T the last one wins, so passing them first
# would let a caller's -tt force a pty. Both spellings lose to this either way,
# since -o RequestTTY never overrides the flag.
fingerprint=$(mktemp "${TMPDIR:-/tmp}/rastro-ssh.XXXXXXXX")
trap 'rm -f "$fingerprint"' EXIT HUP INT TERM

ssh "$@" -T "$destination" "$remote_program" <"$binary" >"$fingerprint"

# Emitted only after a clean exit, so a run that died halfway cannot leave half a
# document on stdout.
cat "$fingerprint"
